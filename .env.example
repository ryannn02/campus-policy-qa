# 校园制度问答助手环境配置模板
# 用法：cp .env.example .env 后填写真实值；.env 已在 .gitignore 中，不会入库。

# ===== 大模型（LLM）=====
# 支持 DeepSeek 与 OpenAI 兼容端点，任选一组填写即可。
# 读取优先级：LLM_* > DEEPSEEK_* > OPENAI_*（见 src/campus_qa/config.py）。

# 当前默认方案：DeepSeek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI 兼容端点（官方直连不可达时可改用代理）：
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai-proxy.org/v1
# OPENAI_MODEL=gpt-4.1-mini

# 统一约定键（docs/development_requirements.md 推荐，可选，优先级最高）：
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com/v1
# CHAT_MODEL=deepseek-chat

# ===== 向量模型 =====
# 默认 BAAI/bge-small-zh-v1.5；短名 bge-small-zh-v1.5 会自动补 BAAI/ 前缀。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# HuggingFace 镜像（国内首次下载向量模型时建议配置）
HF_ENDPOINT=https://hf-mirror.com

# ===== 生活库（M5）=====
# 生活语料与索引，默认 data/life；与制度库物理分离，互不污染
LIFE_DIR=data/life
# LIFE_CHUNKS_PATH=data/life/chunks.jsonl
# LIFE_INDEX_PATH=data/life/index.json
LIFE_TOP_K=3
LIFE_SCORE_THRESHOLD=0.35

# ===== 多轮会话 =====
# SQLite 单文件，存问题/回答/来源，不存个人信息
SESSION_DB_PATH=data/sessions.sqlite3
MAX_CONTEXT_TURNS=3

# ===== 工具 =====
# 天气默认上海浦东（金海路校区），改城市请同时改经纬度
WEATHER_CITY=上海浦东
WEATHER_LATITUDE=31.2215
WEATHER_LONGITUDE=121.5440
TOOL_TIMEOUT_SECONDS=8
# 教学周按 data/academic_calendar.json 里各学期的起点独立计数；
# 仅当该校历文件缺失时，才退回下面这个单一起点
SEMESTER_START=2026-09-21

# ===== 渠道 =====
# 校园墙抓取入口（留空表示尚未配置；配置后 crawl_wall 才能直连）
WALL_ENABLED=false
WALL_SOURCE=
# QQ / OneBot 渠道，默认关闭
QQ_CHANNEL_ENABLED=false

