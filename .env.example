# 校园制度问答助手环境配置模板
# 用法：cp .env.example .env 后填写真实值；.env 已在 .gitignore 中，不会入库。

# ===== 大模型（LLM）=====
# 支持 DeepSeek 与 OpenAI 兼容端点，任选一组填写即可。
# 读取优先级：LLM_* > DEEPSEEK_* > OPENAI_*（见 src/campus_qa/config.py）。

# 当前默认方案：DeepSeek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI 兼容端点（官方直连不可达时可改用代理）：
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai-proxy.org/v1
# OPENAI_MODEL=gpt-4.1-mini

# 统一约定键（docs/development_requirements.md 推荐，可选，优先级最高）：
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com/v1
# CHAT_MODEL=deepseek-chat

# ===== 向量模型 =====
# 默认 BAAI/bge-small-zh-v1.5；短名 bge-small-zh-v1.5 会自动补 BAAI/ 前缀。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# HuggingFace 镜像（国内首次下载向量模型时建议配置）
HF_ENDPOINT=https://hf-mirror.com
